7.#include <stdio.h>

int main() {
    int N, i, sum = 0;

    scanf("%d", &N);

    for (i = 1; i <= N; i++) {
        sum = sum + i;
    }

    printf("%d\n", sum);

    return 0;
}
8.#include <stdio.h>

int main() {
    int N, i;
    long long factorial = 1;

    scanf("%d", &N);

    for (i = 1; i <= N; i++) {
        factorial = factorial * i;
    }

    printf("%lld\n", factorial);

    return 0;
}
